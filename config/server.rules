      # file_unlink: security tool and SSH key deletion
      "./rules_v0.1/fs_security_tool_deletion.file_unlink.detection.yaml",
      "./rules_v0.1/fs_ssh_key_deletion.file_unlink.detection.yaml",
      # file_rename: log tampering
      "./rules_v0.1/fs_log_file_rename.file_rename.detection.yaml",
      # kill: critical daemon stop
      "./rules_v0.1/bin_system_kill_daemon.kill.detection.yaml",
      # send_data: hacking tools exfiltrating to public IPs
      "./rules_v0.1/net_hacking_send_data.send_data.detection.yaml",
      # dns_query: hacking tools beaconing / fast-flux C2
      "./rules_v0.1/net_hacking_dns_query.dns_query.detection.yaml",
      "./rules_v0.1/net_dns_fast_flux.dns_query.detection.yaml",
      # read_config: hacking tools reading credential files
      "./rules_v0.1/config_hacking_read_sensitive.read_config.detection.yaml",
      # init_module: known rootkit module names
      "./rules_v0.1/bin_kernel_rootkit_module.init_module.detection.yaml",
      # prctl: Yama ptrace scope bypass
      "./rules_v0.1/bin_system_prctl_ptracer.prctl.detection.yaml",

      # --- round 9: SMB/NFS lateral movement, USB HID attack devices ---
      # SMB lateral movement
      "./rules_v0.1/bin_network_smb_client_list.dependency.yaml",
      "./rules_v0.1/bin_network_smb_client.execve.detection.yaml",
      "./rules_v0.1/bin_network_smb_client.connect.detection.yaml",
      # NFS lateral movement
      "./rules_v0.1/bin_network_nfs_client_list.dependency.yaml",
      "./rules_v0.1/bin_network_nfs_client.execve.detection.yaml",
      "./rules_v0.1/bin_network_nfs_client.connect.detection.yaml",
      # USB HID attack device detection (Teensy/Rubber Ducky/O.MG)
      "./rules_v0.1/path_usb_attack_device_list.file_create.dependency.yaml",
      "./rules_v0.1/fs_usb_attack_device.file_create.detection.yaml",

    ]

  

  # Path to files or directories containing IoCs to be loaded.
  # Supported file extensions: ioc.
  iocs: [
      
  ]

  # Path to files or directories containing YARA rules.
  # Supported file extensions: yar, yara.
  yara: []

  min_severity: 3

  # Ensure every positive YARA file scan will be displayed.
  show_positive_file_scan: true

events:
  # Enable or disable specific events.
  execve:
    enable: true
  execve_script:
    enable: true
  exit:
    enable: true
  exit_group:
    enable: true
  clone:
    enable: true
  prctl:
    enable: true
  kill:
    enable: true
  ptrace:
    enable: true
  init_module:
    enable: true
  bpf_prog_load:
    enable: true
  bpf_socket_filter:
    enable: true
  mprotect_exec:
    enable: true
  mmap_exec:
    enable: true
  connect:
    enable: true
  dns_query:
    enable: true
  send_data:
    enable: true
  read:
    enable: false
  read_config:
    enable: true
  write:
    enable: true
  write_config:
    enable: true
  file_rename:
    enable: true
  file_unlink:
    enable: true
  write_close:
    enable: true
  file_scan:
    enable: true
  io_uring_sqe:
    enable: true
  file_create:
    enable: true


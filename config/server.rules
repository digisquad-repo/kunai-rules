# UUID identifying the host. This is auto-generated and should not be changed.
host_uuid: c030b40d-0eab-417b-b33a-22d952357984

max_buffered_events: 65536   # kernel eBPF ring buffer size (events) — raised from 4096
max_eps_fs: 65535            # max filesystem events/sec per CPU — raised from 2048
workers: null
send_data_min_len: null
harden: false

output:
  path: /dev/stdout
  rotate_size: null
  max_size: null
  buffered: false

# Wazuh integration: pipe Kunai JSON to Wazuh agent, then uncomment and adjust:
# output:
#   path: /var/log/kunai/kunai.json
#   buffered: true

